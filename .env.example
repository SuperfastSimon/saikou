# Every variable below is read by the code. Load with `uvicorn --env-file .env`
# or export them yourself. `saikou harden` and `saikou ui` also read ./.env (or --env-file),
# but only provider keys, model names, LLM_TIMEOUT_S and LLM_MAX_OUTPUT_TOKENS. An endpoint
# (*_BASE_URL, OLLAMA_LOCAL_URL) and LLM_PROVIDER must come from your environment or a flag
# (--base-url, --provider), so a .env in someone else's repository cannot choose where your
# key goes. A run whose endpoint is set only in .env (to anything but the default) stops.

# --- LLM provider (OpenAI-compatible: OpenAI, OpenRouter, LiteLLM, vLLM, Ollama, ...) ---
# Used by `saikou harden` (key variable name configurable with --api-key-env) and the API.
LLM_API_KEY=
# Read from this file by the hosted API (uvicorn --env-file) only; for saikou harden set it
# in your environment or pass --base-url.
# LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TIMEOUT_S=90
LLM_MAX_OUTPUT_TOKENS=8000

# --- HTTP API only (saikou.api) ---
# Comma-separated bearer tokens. Without tokens the API refuses to serve unless ENVIRONMENT=dev.
API_TOKENS=
# production (default) hides /docs, /redoc and /openapi.json; dev allows an open local instance.
ENVIRONMENT=production
# Per file (characters), per batch request (characters), and per request body (bytes).
MAX_INPUT_CHARS=60000
MAX_TOTAL_CHARS=400000
MAX_BODY_BYTES=2000000
RATE_LIMIT_PER_MINUTE=20
# The web playground on / (Verify and Checks only). 0 switches it off.
PLAYGROUND=1
SESSION_TTL_S=1800
MAX_SESSIONS=500

# --- Ollama (saikou harden --provider ollama | local) ---
# Cloud: create a key at https://ollama.com/settings/keys and put it in your own .env
# (git-ignored), never in this file. Endpoint https://ollama.com/v1, sent as a Bearer token.
OLLAMA_API_KEY=
# Optional: another cloud model (names from https://ollama.com/api/tags), default gpt-oss:120b
OLLAMA_MODEL=
# Local models (--provider local): no key. Picks an installed model unless you name one.
# OLLAMA_API_KEY is never sent to a local model; set this only if your local server needs a key.
# OLLAMA_LOCAL_API_KEY=
# OLLAMA_LOCAL_MODEL=qwen2.5-coder:3b
# OLLAMA_LOCAL_URL=http://localhost:11434/v1
# Choose a provider without a flag: openai | ollama | local (environment only, not read from
# this file by saikou harden or saikou ui)
# LLM_PROVIDER=ollama
